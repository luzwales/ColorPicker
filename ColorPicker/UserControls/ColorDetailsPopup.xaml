<UserControl
    x:Class="ColorPicker.UserControls.ColorDetailsPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:ColorPicker.Properties"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="300"
    FontFamily="../Fonts/#Hauora"
    Foreground="{DynamicResource Foreground1}"
    mc:Ignorable="d">

    <Border
        Padding="12"
        Background="{DynamicResource Background1}"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Opacity="0.4"
                RenderingBias="Performance"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0 0 0 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ColorBorder"
                    Width="30"
                    Height="30"
                    d:Background="#ff0000"
                    CornerRadius="5" />
                <TextBlock
                    x:Name="TitleTxt"
                    Grid.Column="1"
                    Margin="8 0"
                    VerticalAlignment="Center"
                    d:Text="#FF0000"
                    FontSize="14"
                    FontWeight="ExtraBold" />
                <Button
                    x:Name="BookmarkBtn"
                    Grid.Column="2"
                    Padding="5"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Background3}"
                    Click="BookmarkBtn_Click"
                    Content="&#xF1F6;"
                    FontFamily="..\Fonts\#FluentSystemIcons-Regular"
                    Foreground="{DynamicResource Foreground1}"
                    Style="{DynamicResource DefaultButton}">
                    <Button.ToolTip>
                        <ToolTip
                            x:Name="BookmarkToolTip"
                            Background="{DynamicResource Background1}"
                            Content="{x:Static lang:Resources.AddBookmark}"
                            Foreground="{DynamicResource Foreground1}" />
                    </Button.ToolTip>
                </Button>
            </Grid>
            <StackPanel x:Name="RowsPanel" />
        </StackPanel>
    </Border>
</UserControl>
