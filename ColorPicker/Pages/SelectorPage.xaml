<Page
    x:Class="ColorPicker.Pages.SelectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:ColorPicker.Properties"
    xmlns:local="clr-namespace:ColorPicker.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:ColorPicker.UserControls"
    Title="SelectorPage"
    d:DesignHeight="520"
    d:DesignWidth="850"
    FontFamily="../Fonts/#Hauora"
    Foreground="{DynamicResource Foreground1}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面顶部标题栏加入“返回上一页”按钮 -->
        <StackPanel Margin="10" Orientation="Horizontal">
            <Button
                x:Name="BackBtn"
                Margin="0 0 10 0"
                Padding="6 3"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="BackBtn_Click"
                Content="&#xE72B;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Foreground="{DynamicResource Foreground1}"
                Style="{DynamicResource DefaultButton}">
                <Button.ToolTip>
                    <ToolTip
                        Background="{DynamicResource Background1}"
                        Content="返回上一页"
                        Foreground="{DynamicResource Foreground1}" />
                </Button.ToolTip>
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="../Fonts/#FluentSystemIcons-Regular"
                FontSize="16"
                Foreground="{DynamicResource AccentColor}"
                Text="&#xF9AB;" />
            <TextBlock
                x:Name="TitleTxt"
                Margin="5 0 0 0"
                VerticalAlignment="Center"
                d:Text="{x:Static lang:Resources.Selector}"
                FontSize="14"
                FontWeight="ExtraBold" />
        </StackPanel>

        <WrapPanel
            x:Name="RecentColorsPanel"
            Grid.Row="1"
            Margin="5" />

        <Border
            Grid.Row="2"
            MinWidth="720"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource LightAccentColor}"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.2"
                    ShadowDepth="0"
                    Color="{DynamicResource Accent}" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Column 0: PixiEditor ColorPicker Wheel (Left Side) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Column 1: Right Side (Tabs + Sliders + Input Fields) -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: SquarePicker (Hue Ring + HSV/HSL Square) -->
                <StackPanel Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">
                    <uc:ColorWheelControl
                        x:Name="WheelPicker"
                        Width="220"
                        Height="220" />
                </StackPanel>

                <!-- Right: Header Tab-Buttons and Sliders Grid below it -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Flat buttons tab bar for format selecting -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Sliders, ColorBorder, Hex Textbox and Action buttons -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Flat buttons Tab bar (same style as PalettePage) -->
                    <StackPanel Grid.Row="0" Margin="0 0 0 10" Orientation="Horizontal">
                        <Button
                            x:Name="RgbBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.RGB}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="HexBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.HEX}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="HsvBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.HSV}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="HslBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.HSL}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="CmykBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.CMYK}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="DecBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.DEC}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="XyzBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.XYZ}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="YiqBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.YIQ}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                        <Button
                            x:Name="YuvBtn"
                            Margin="4 2"
                            Padding="8 4"
                            Click="RgbBtn_Click"
                            Content="{x:Static lang:Resources.YUV}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{DynamicResource DefaultButton}" />
                    </StackPanel>

                    <!-- Main UI layout underneath the tab bar -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Col 0: ColorBorder + HEX Input underneath -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Col 1: Sliders & Textboxes (Stacked) -->
                            <ColumnDefinition Width="*" />
                            <!-- Col 2: Action buttons -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Circular ColorBorder (HEX input 1 removed per request, now purely color display) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="5 0 15 0">
                            <Border
                                x:Name="ColorBorder"
                                Width="75"
                                Height="75"
                                CornerRadius="50"
                                Cursor="Hand"
                                MouseLeftButtonUp="ColorBorder_MouseLeftButtonUp"
                                d:Background="#ff0000" />
                        </StackPanel>

                        <!-- Middle: Sliders & Textboxes (Stacked) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10 0">
                            <!-- Sliders Grid (RGB/HSV/HSL/CMYK) -->
                            <!-- Sliders remain untouched for great manual adjustment! -->
                            <Grid x:Name="SlidersGrid" Margin="0 0 0 15">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="35" />
                                </Grid.ColumnDefinitions>

                                <Slider
                                    x:Name="RedSlider"
                                    Grid.Column="0"
                                    Width="255"
                                    VerticalAlignment="Center"
                                    BorderBrush="#FF4500"
                                    Foreground="#FF4500"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    SmallChange="1"
                                    Style="{DynamicResource SliderStyle1}"
                                    ValueChanged="RedSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="RedValueTxt"
                                    Grid.Column="2"
                                    Margin="3"
                                    HorizontalAlignment="Center"
                                    d:Text="255"
                                    FontSize="14"
                                    FontWeight="ExtraBold" />

                                <Slider
                                    x:Name="GreenSlider"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="255"
                                    VerticalAlignment="Center"
                                    BorderBrush="#00df39"
                                    Foreground="#00df39"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    SmallChange="1"
                                    Style="{DynamicResource SliderStyle1}"
                                    ValueChanged="GreenSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="GreenValueTxt"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="3"
                                    HorizontalAlignment="Center"
                                    d:Text="255"
                                    FontSize="14"
                                    FontWeight="ExtraBold" />

                                <Slider
                                    x:Name="BlueSlider"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Width="255"
                                    VerticalAlignment="Center"
                                    BorderBrush="#4169E1"
                                    Foreground="#4169E1"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    SmallChange="1"
                                    Style="{DynamicResource SliderStyle1}"
                                    ValueChanged="BlueSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="BlueValueTxt"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="3"
                                    HorizontalAlignment="Center"
                                    d:Text="255"
                                    FontSize="14"
                                    FontWeight="ExtraBold" />
                                <Slider
                                    x:Name="KSlider"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Width="255"
                                    VerticalAlignment="Center"
                                    BorderBrush="#4169E1"
                                    Foreground="#4169E1"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    SmallChange="1"
                                    Style="{DynamicResource SliderStyle1}"
                                    ValueChanged="KSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="KValueTxt"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="3"
                                    HorizontalAlignment="Center"
                                    d:Text="255"
                                    FontSize="14"
                                    FontWeight="ExtraBold" />
                            </Grid>

                            <!-- 精美重用：调色板/对比网格的九格式多 TextBox 输入框组件，与上方的 Tab 完美合并联动 -->
                            <StackPanel x:Name="InputBoxesPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock
                                    x:Name="DisplayText1"
                                    Margin="0 0 10 0"
                                    VerticalAlignment="Center"
                                    FontWeight="ExtraBold"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="B1"
                                    Width="50"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="5"
                                    Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="0" Color="{DynamicResource Accent}" />
                                    </Border.Effect>
                                    <Grid>
                                        <TextBox
                                            x:Name="Txt1"
                                            Margin="3"
                                            Padding="3"
                                            d:Text="123"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CommandManager.CanExecute="Txt1_CanExecute"
                                            CommandManager.PreviewExecuted="Txt1_PreviewExecuted"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground1}"
                                            TextAlignment="Center"
                                            TextChanged="Txt1_TextChanged" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    x:Name="DisplayText2"
                                    Margin="10 0 10 0"
                                    VerticalAlignment="Center"
                                    FontWeight="ExtraBold"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="B2"
                                    Width="50"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="5"
                                    Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="0" Color="{DynamicResource Accent}" />
                                    </Border.Effect>
                                    <Grid>
                                        <TextBox
                                            x:Name="Txt2"
                                            Margin="3"
                                            Padding="3"
                                            d:Text="123"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CommandManager.CanExecute="Txt1_CanExecute"
                                            CommandManager.PreviewExecuted="Txt1_PreviewExecuted"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground1}"
                                            TextAlignment="Center"
                                            TextChanged="Txt1_TextChanged" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    x:Name="DisplayText3"
                                    Margin="10 0 10 0"
                                    VerticalAlignment="Center"
                                    FontWeight="ExtraBold"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="B3"
                                    Width="50"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="5"
                                    Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="0" Color="{DynamicResource Accent}" />
                                    </Border.Effect>
                                    <Grid>
                                        <TextBox
                                            x:Name="Txt3"
                                            Margin="3"
                                            Padding="3"
                                            d:Text="123"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CommandManager.CanExecute="Txt1_CanExecute"
                                            CommandManager.PreviewExecuted="Txt1_PreviewExecuted"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground1}"
                                            TextAlignment="Center"
                                            TextChanged="Txt1_TextChanged" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    x:Name="DisplayText4"
                                    Margin="10 0 10 0"
                                    VerticalAlignment="Center"
                                    FontWeight="ExtraBold"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="B4"
                                    Width="50"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="5"
                                    Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="0" Color="{DynamicResource Accent}" />
                                    </Border.Effect>
                                    <Grid>
                                        <TextBox
                                            x:Name="Txt4"
                                            Margin="3"
                                            Padding="3"
                                            d:Text="123"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CommandManager.CanExecute="Txt1_CanExecute"
                                            CommandManager.PreviewExecuted="Txt1_PreviewExecuted"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground1}"
                                            TextAlignment="Center"
                                            TextChanged="Txt1_TextChanged" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    x:Name="DisplayText5"
                                    Margin="10 0 10 0"
                                    VerticalAlignment="Center"
                                    FontWeight="ExtraBold"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="B5"
                                    Width="110"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="5"
                                    Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="0" Color="{DynamicResource Accent}" />
                                    </Border.Effect>
                                    <Grid>
                                        <TextBox
                                            x:Name="Txt5"
                                            Margin="3"
                                            Padding="3"
                                            d:Text="123"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CommandManager.CanExecute="Txt1_CanExecute"
                                            CommandManager.PreviewExecuted="Txt1_PreviewExecuted"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground1}"
                                            TextAlignment="Center"
                                            TextChanged="Txt1_TextChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button
                                x:Name="SelectBtn"
                                Margin="10 0 0 0"
                                Padding="5"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Background3}"
                                Click="SelectBtn_Click"
                                Content="&#xFD3F;"
                                FontFamily="..\Fonts\#FluentSystemIcons-Regular"
                                Foreground="{DynamicResource Foreground1}"
                                Style="{DynamicResource DefaultButton}">
                                <Button.ToolTip>
                                    <ToolTip
                                        Background="{DynamicResource Background1}"
                                        Content="{x:Static lang:Resources.SelectColor}"
                                        Foreground="{DynamicResource Foreground1}" />
                                </Button.ToolTip>
                            </Button>
                            <Button
                                x:Name="PaletteBtn"
                                Padding="5"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Background3}"
                                Click="PaletteBtn_Click"
                                Content="&#xF2F6;"
                                FontFamily="..\Fonts\#FluentSystemIcons-Regular"
                                Foreground="{DynamicResource Foreground1}"
                                Style="{DynamicResource DefaultButton}">
                                <Button.ToolTip>
                                    <ToolTip
                                        Background="{DynamicResource Background1}"
                                        Content="{x:Static lang:Resources.GenerateColor}"
                                        Foreground="{DynamicResource Foreground1}" />
                                </Button.ToolTip>
                            </Button>
                            <Button
                                x:Name="BookmarkBtn"
                                Padding="5"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Background3}"
                                Click="BookmarkBtn_Click"
                                Content="&#xF1F6;"
                                FontFamily="..\Fonts\#FluentSystemIcons-Regular"
                                Foreground="{DynamicResource Foreground1}"
                                Style="{DynamicResource DefaultButton}">
                                <Button.ToolTip>
                                    <ToolTip
                                        x:Name="BookmarkToolTip"
                                        Background="{DynamicResource Background1}"
                                        Content="{x:Static lang:Resources.AddBookmark}"
                                        Foreground="{DynamicResource Foreground1}" />
                                </Button.ToolTip>
                            </Button>
                            <Popup
                                x:Name="CollectionsPopup"
                                AllowsTransparency="True"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=BookmarkBtn}"
                                PopupAnimation="Fade"
                                StaysOpen="False">
                                <Border
                                    Margin="10"
                                    Padding="10"
                                    Background="{DynamicResource Background1}"
                                    CornerRadius="5">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.4"
                                            RenderingBias="Performance"
                                            ShadowDepth="0"
                                            Color="Black" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Button
                                            x:Name="AddRemoveBookmarkBtn"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            Click="AddRemoveBookmarkBtn_Click"
                                            Content="{x:Static lang:Resources.AddBookmark}"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground1}"
                                            Style="{DynamicResource DefaultButton}" />
                                        <StackPanel x:Name="CollectionsPanel" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="3"
            Margin="10"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="../Fonts/#FluentSystemIcons-Regular"
                FontSize="16"
                Foreground="{DynamicResource AccentColor}"
                Text="&#xF4A4;" />
            <TextBlock
                Margin="5 0 0 0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="ExtraBold"
                Text="{x:Static lang:Resources.Details}" />
        </StackPanel>

        <Grid
            x:Name="DetailsWrap"
            Grid.Row="4"
            Margin="0 0 0 10" />
    </Grid>
</Page>
