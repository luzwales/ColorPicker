<Window x:Class="ColorPicker.Windows.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:ColorPicker.UserControls"
        Title="颜色选择" Height="285" Width="280" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Deactivated="Window_Deactivated">
    <Border CornerRadius="12" Background="{DynamicResource Background1}" Margin="12" Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 给色轮足额空间 (220x220)，并确保能自动拉伸 -->
            <uc:ColorWheelControl x:Name="Picker" Width="220" Height="220" ColorChanged="Picker_ColorChanged" />
        </Grid>
    </Border>
</Window>